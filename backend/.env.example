APP_NAME=GeoMine3D API
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
# 日志:级别 / 是否输出访问日志 / 是否打印 SQL 语句
LOG_LEVEL=INFO
ACCESS_LOG=true
DB_ECHO=false
DATABASE_URL=mysql+asyncmy://geomine:geomine@127.0.0.1:3306/geomine3d?charset=utf8mb4
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
UPLOAD_DIR=uploads
MODEL_PUBLIC_PREFIX=/uploads
MAX_UPLOAD_SIZE_MB=1024
SOURCE_DATA_DIR=../server/data
SOURCE_MODEL_DIR=../server/static/models
SOURCE_MODEL_CATALOG=../server/static/models/web_package/catalog.json
BOREHOLE_LOCATION_FILE=location/钻孔位置.xlsx
BOREHOLE_STRATA_FILE=boreholes/地层汇总14层.xlsx
FRONTEND_DIST_DIR=../GeoMine3D/dist
SERVE_FRONTEND=true
